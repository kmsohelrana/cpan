APP_NAME='SSL Wireless CRM'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Exactly 32 characters, used as the AES-256-CBC key for merchant PIN encryption
# (app/helpers.php encryptPin/decryptPin). No fallback in config/app.php - required.
# [PLACEHOLDER] - generate a real value per environment, never reuse across environments,
# and never commit the real value.
APP_PIN_SALT=[PLACEHOLDER]

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bank_crm
DB_USERNAME=root
DB_PASSWORD=

# Safety Guard: blocks accidental migrate:fresh, migrate:reset, db:wipe
PROHIBIT_DESTRUCTIVE_COMMANDS=true

# Oracle Primary Database (Connection: 'oracle')
ORACLE_DB_HOST=127.0.0.1
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE_NAME=
ORACLE_DB_DATABASE=
ORACLE_DB_USERNAME=
ORACLE_DB_PASSWORD=
ORACLE_DB_CHARSET=AL32UTF8
ORACLE_DB_SCHEMA=
ORACLE_DB_TNS=

# Oracle Secondary Database (Connection: 'oracle2')
ORACLE2_DB_HOST=127.0.0.1
ORACLE2_DB_PORT=1521
ORACLE2_DB_SERVICE_NAME=
ORACLE2_DB_DATABASE=
ORACLE2_DB_USERNAME=
ORACLE2_DB_PASSWORD=
ORACLE2_DB_CHARSET=AL32UTF8
ORACLE2_DB_SCHEMA=
ORACLE2_DB_TNS=

# Oracle Tertiary Database (Connection: 'oracle3')
ORACLE3_DB_HOST=127.0.0.1
ORACLE3_DB_PORT=1521
ORACLE3_DB_SERVICE_NAME=
ORACLE3_DB_DATABASE=
ORACLE3_DB_USERNAME=
ORACLE3_DB_PASSWORD=
ORACLE3_DB_CHARSET=AL32UTF8
ORACLE3_DB_SCHEMA=
ORACLE3_DB_TNS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOG_FILE_NAME_PREFIX='NODE-'

CHECK_INCOMING_IP=false

PASSWORD_HISTORY_LIMIT=3
ENABLE_FORCE_PASSWORD_CHANGE='off'
ENABLE_PASSWORD_EXPIRATION='off'
PASSWORD_EXPIRES_AFTER_DAYS=90

OCR_NID_DOMAIN_URL=''
OCR_NID_ACCESS_TOKEN=''
OCR_MANUAL_ENTRY_ALLOWED='ON'

MERCHANT_MIN_AGE=18
SELF_SIGNUP_ALLOWED=true

OTP_DAILY_LIMIT=500
OTP_EXPIRY_TIME=60
OTP_RESEND_INTERVAL=60
OTP_MAX_PER_USER=10
FIXED_OTP_MOBILE_NO='01924278435'

CRM_ANDROID_APP_VERSION=1.0.0
CRM_IOS_APP_VERSION=1.0.0
CRM_APP_OTP_ENABLE=false

MERCHANT_APP_LINK=
CRM_APP_LINK=

MERCHANT_ANDROID_APP_VERSION=1.0.0
MERCHANT_IOS_APP_VERSION=1.0.0

